{
  "name": "noclip",
  "version": "0.1.0",
  "private": true,
  "description": "NOCLIP \u2014 an isometric low-poly pixel-art survival sandbox set inside a liminal, collapsing simulation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "server": "node server/server.mjs",
    "start": "npm run build && node server/server.mjs",
    "desktop": "cd desktop && npm install --no-audit --no-fund",
    "desktop:dev": "VITE_DESKTOP=1 npx vite build --outDir desktop/game --emptyOutDir && cd desktop && npx electron . --dev-tools",
    "steam": "node scripts/steam.mjs win linux",
    "steam:linux": "node scripts/steam.mjs linux",
    "steam:win": "node scripts/steam.mjs win",
    "steam:mac": "node scripts/steam.mjs mac",
    "steam:all": "node scripts/steam.mjs win linux mac --zip",
    "steam:achievements": "node scripts/steam-ach.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "playwright-core": "1.56.1"
  }
}
